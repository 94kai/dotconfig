[
    {
        "key": "g d",
        "command": "editor.action.revealDefinition",
        "when": "vim.mode == 'Normal' && editorHasDefinitionProvider && editorTextFocus"
    },
    {
        "key": "g d",
        "command": "editor.gotoNextSymboilFromResult",
        "when": "vim.mode == 'Normal' && hasSymbols"
    },
    {
        "key": "g d",
        "command": "goToNextReference",
        "when": "vim.mode == 'Normal' && inReferenceSearchEditor || referenceSearchVisible"
    },
    {
        "key": "g R",
        "command": "goToPreviousReference",
        "when": "vim.mode == 'Normal' && inReferenceSearchEditor || referenceSearchVisible"
    },
    {
        "key": "g R",
        "command": "editor.action.goToReferences",
        "when": "vim.mode == 'Normal' && editorHasReferenceProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
    },
    {
        "key": "g i",
        "command": "editor.action.peekImplementation",
        "when": "vim.mode == 'Normal' && editorHasImplementationProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
    },
    {
        "key": "g D",
        "command": "editor.action.peekDefinition",
        "when": "vim.mode == 'Normal' && editorHasDefinitionProvider && editorTextFocus && !inReferenceSearchEditor && !isInEmbeddedEditor"
    }
]
