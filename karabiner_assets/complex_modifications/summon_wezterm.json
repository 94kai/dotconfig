{
  "title": "Summon WezTerm",
  "rules": [
    {
      "description": "Summon WezTerm",
      "manipulators": [
        {
          "from": {
            "key_code": "j",
            "modifiers": {
              "mandatory": [
                "left_command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -a WezTerm"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
